{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewed_commit",
    "coverage",
    "findings"
  ],
  "properties": {
    "reviewed_commit": {
      "type": "string"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas_reviewed",
        "areas_not_reviewed"
      ],
      "properties": {
        "areas_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "areas_not_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "path",
          "line",
          "claim",
          "evidence",
          "evidence_type",
          "suggested_fix",
          "ac_ids",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "executed",
              "static"
            ]
          },
          "suggested_fix": {
            "type": "string"
          },
          "ac_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}